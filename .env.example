# Environment variables that Mail-MCP reads. Nothing loads this file by itself: set them in
# your shell, or in your MCP client's configuration (for example "env" in a JSON server entry).

# Optional: Application (client) ID of your own Microsoft Entra app registration. A client ID
# is built in, so leave this unset (or empty) to use the built-in Mail-MCP app.
# MAIL_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: where the OAuth token cache is stored, as an absolute path (default ~/.mail-mcp/token-cache.json)
# MAIL_MCP_CACHE_PATH=/home/you/.mail-mcp/token-cache.json
