{
  "name": "mail-mcp",
  "version": "0.1.0",
  "description": "MCP server for a personal Outlook.com mailbox: read, classify, delete, unsubscribe.",
  "type": "module",
  "private": true,
  "bin": {
    "mail-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "login": "tsx scripts/login.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector@latest node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "html-to-text": "^10.0.1",
    "open": "^11.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
